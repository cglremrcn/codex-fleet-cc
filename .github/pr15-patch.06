diff --git a/plugins/fleet/scripts/lib/operator-context.mjs b/plugins/fleet/scripts/lib/operator-context.mjs
new file mode 100644
index 0000000..e051aa2
--- /dev/null
+++ b/plugins/fleet/scripts/lib/operator-context.mjs
@@ -0,0 +1,147 @@
+import fs from "node:fs/promises";
+import path from "node:path";
+import { spawnSync } from "node:child_process";
+
+import { resolveOwnedPath, workspaceKey } from "./paths.mjs";
+import { readWorkspaceState } from "./safe-state.mjs";
+import {
+  listRegisteredWorkspaces,
+  resolveRegisteredWorkspace
+} from "./workspace-registry.mjs";
+
+const MAX_CONFIG_BYTES = 256 * 1024;
+const MAX_RELATED_LEDGERS = 16;
+
+function safeSpawn(workspace, args, options = {}) {
+  const run = options.spawnSync ?? spawnSync;
+  return run("git", args, {
+    cwd: workspace,
+    encoding: "utf8",
+    maxBuffer: 128 * 1024,
+    shell: false,
+    timeout: 2_000,
+    windowsHide: true
+  });
+}
+
+function firstLine(result) {
+  if (result?.status !== 0 || result?.error) return null;
+  const value = String(result.stdout ?? "").trim().split(/\r?\n/u)[0];
+  return value || null;
+}
+
+/** Resolve only implicit CWDs to their actual Git worktree root. Explicit --workspace stays exact. */
+export function resolveImplicitWorkspace(candidate, options = {}) {
+  const absolute = path.resolve(candidate);
+  if (options.implicit !== true) return absolute;
+  const top = firstLine(safeSpawn(absolute, ["rev-parse", "--show-toplevel"], options));
+  return top && path.isAbsolute(top) ? path.resolve(top) : absolute;
+}
+
+export function gitCommonDirectory(workspace, options = {}) {
+  const value = firstLine(safeSpawn(workspace, ["rev-parse", "--git-common-dir"], options));
+  if (!value) return null;
+  return path.resolve(workspace, value);
+}
+
+async function canonical(value) {
+  try { return await fs.realpath(value); }
+  catch { return path.resolve(value); }
+}
+
+/**
+ * Warn instead of silently merging ledgers when sibling worktrees contain Fleet state.
+ * Returned data contains keys/names/counts, never private paths.
+ */
+export async function findRelatedWorkspaceLedgers(context, options = {}) {
+  const readState = options.readState ?? readWorkspaceState;
+  const listProjects = options.listRegisteredWorkspaces ?? listRegisteredWorkspaces;
+  const resolveProject = options.resolveRegisteredWorkspace ?? resolveRegisteredWorkspace;
+  const currentCommon = gitCommonDirectory(context.workspace, options);
+  if (!currentCommon) return null;
+  const common = await canonical(currentCommon);
+  let registry;
+  try { registry = await listProjects(context.dataDir); }
+  catch { return null; }
+  const related = [];
+  for (const project of registry.projects ?? []) {
+    if (project.workspaceKey === context.key || project.registered !== true) continue;
+    if (related.length >= MAX_RELATED_LEDGERS) break;
+    try {
+      const resolved = await resolveProject(context.dataDir, project.workspaceKey);
+      const otherCommon = gitCommonDirectory(resolved.workspacePath, options);
+      if (!otherCommon || await canonical(otherCommon) !== common) continue;
+      const root = resolveOwnedPath(context.dataDir, "workspaces", project.workspaceKey);
+      const state = await readState(root);
+      const visible = (state.lanes ?? []).filter((lane) => !lane.archivedAt);
+      if (visible.length === 0) continue;
+      related.push(Object.freeze({
+        workspaceKey: project.workspaceKey,
+        name: project.name,
+        laneCount: visible.length,
+        activeCount: visible.filter((lane) => ["queued", "starting", "running"].includes(lane.status)).length,
+        attentionCount: visible.filter((lane) => lane.controllerRequest || ["blocked", "interrupted", "outcome_unknown"].includes(lane.status)).length
+      }));
+    } catch {
+      // A stale/unreadable sibling registration cannot make the current ledger unsafe.
+    }
+  }
+  if (related.length === 0) return null;
+  return Object.freeze({
+    kind: "related-worktree-ledgers",
+    message: "This Fleet ledger has no visible lanes, but related Git worktrees have Fleet lanes. Use the exact worktree workspace or `fleet projects`; Fleet will not merge control authority across ledgers.",
+    relatedLedgerCount: related.length,
+    relatedLaneCount: related.reduce((sum, item) => sum + item.laneCount, 0),
+    ledgers: Object.freeze(related)
+  });
+}
+
+/** Read only the top-level Codex model preference; never parse or return other config values. */
+export async function readConfiguredCodexModel(io, options = {}) {
+  const home = options.codexHome
+    ?? io.env.CODEX_HOME
+    ?? path.join(io.home, ".codex");
+  const configPath = path.join(path.resolve(home), "config.toml");
+  try {
+    const metadata = await fs.lstat(configPath);
+    if (!metadata.isFile() || metadata.isSymbolicLink() || metadata.size > MAX_CONFIG_BYTES) return null;
+    const text = await fs.readFile(configPath, "utf8");
+    let inTable = false;
+    for (const rawLine of text.split(/\r?\n/u)) {
+      const line = rawLine.trim();
+      if (!line || line.startsWith("#")) continue;
+      if (line.startsWith("[")) { inTable = true; continue; }
+      if (inTable) continue;
+      const match = /^model\s*=\s*(["'])([^"'\r\n]{1,80})\1\s*(?:#.*)?$/u.exec(line);
+      if (match && !/[\u0000-\u001f\u007f]/u.test(match[2])) return match[2];
+    }
+  } catch (error) {
+    if (error?.code !== "ENOENT") return null;
+  }
+  return null;
+}
+
+export async function validateQualifiedRetryRefs(contract, context, options = {}) {
+  const resolveProject = options.resolveRegisteredWorkspace ?? resolveRegisteredWorkspace;
+  const readState = options.readState ?? readWorkspaceState;
+  for (const lane of contract.lanes ?? []) {
+    if (typeof lane.retryOf !== "string" || !lane.retryOf.includes(":")) continue;
+    const separator = lane.retryOf.indexOf(":");
+    const sourceKey = lane.retryOf.slice(0, separator);
+    const sourceLaneId = lane.retryOf.slice(separator + 1);
+    let source;
+    try { source = await resolveProject(context.dataDir, sourceKey); }
+    catch {
+      throw new Error(`Qualified retry source workspace is not registered or readable: ${sourceKey}.`);
+    }
+    const sourceRoot = resolveOwnedPath(context.dataDir, "workspaces", source.workspaceKey);
+    const state = await readState(sourceRoot);
+    const prior = (state.lanes ?? []).find((candidate) => candidate.id === sourceLaneId);
+    if (!prior) throw new Error(`Qualified retry source lane was not found: ${lane.retryOf}.`);
+    if (["outcome_unknown", "interrupted"].includes(prior.status) && !lane.reconciliationRef) {
+      throw new Error(
+        `Qualified retry source ${lane.retryOf} is ${prior.status}; provide reconciliationRef before a new worktree retries it.`
+      );
+    }
+  }
+}
