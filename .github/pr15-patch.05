+      completion: ["Verify the delivered file exists, has the requested type/dimensions, and return its workspace-relative path."],
+      controller: ["Parent Claude must open the returned image and perform visual QA; path existence alone is not visual evidence."]
+    };
+  }
+  return {
+    start: ["Confirm required workspace evidence is readable."],
+    completion: ["Re-open cited evidence and distinguish observations from inference."],
+    controller: ["Escalate only evidence surfaces that genuinely require unavailable authority/capability."]
+  };
