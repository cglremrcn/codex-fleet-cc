+    return {
+      start: [
+        "Confirm the artifact/evidence and exact worktree are readable; do not rely on worker reasoning."
+      ],
+      completion: [
+        "Re-run only read-only-compatible checks. For Python/pytest prefer PYTHONDONTWRITEBYTECODE=1 and -p no:cacheprovider when cache writes are unnecessary.",
+        "Attempt to falsify behavior, not merely pin source text."
+      ],
+      controller: [
