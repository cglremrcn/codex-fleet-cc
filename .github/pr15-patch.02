diff --git a/plugins/fleet/scripts/lib/cli-help.mjs b/plugins/fleet/scripts/lib/cli-help.mjs
new file mode 100644
index 0000000..efbf272
--- /dev/null
+++ b/plugins/fleet/scripts/lib/cli-help.mjs
@@ -0,0 +1,107 @@
+const ROOT = `Codex Fleet CLI
+
+Usage:
+  fleet <command> [options]
+  fleet --help
+  fleet <command> --help
+
+Operator commands:
+  status       Read lane state without starting work
+  result       Read one lane result; --wait uses supervisor events, not shell polling
+  watch        Wait for one meaningful Fleet transition without model polling
+  models       Discover exact connected-runtime models; --refresh restarts an idle app-server
+  cancel       Preview/confirm cancellation; supports: cancel <laneId> --workspace <path>
+  reconcile    Resolve an ambiguous continuation reservation safely
+  resolve      Attach explicit reconciliation evidence to unknown/interrupted work
+  archive      Hide a terminal lane from default status
+  follow-up    Continue the same owned Codex thread using a JSON contract
+  start        Admit bounded lane contracts
+
+Use `fleet <command> --help` for exact JSON shapes and examples.`;
+
+const HELP = Object.freeze({
+  start: `Usage: fleet start --stdin --json | --contract <file> --json
+
+Root JSON shape:
+{
+  "schemaVersion": 1,
+  "workspacePath": "/absolute/worktree",
+  "modelPolicy": "runtime",
+  "sharedContext": "stable workspace rules shared by sibling lan