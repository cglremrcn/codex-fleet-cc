es",
+  "lanes": [{
+    "id": "bounded-task",
+    "role": "implementer",
+    "model": "<exact fleet models id>",
+    "effort": "high",
+    "prompt": "task-specific objective",
+    "verificationPlan": {
+      "start": ["preconditions only"],
+      "completion": ["lane-runnable checks"],
+      "controller": ["checks requiring unavailable DB/browser/build capability"]
+    },
+    "authority": {"sandbox":"workspace-write","process":{"start":true}}
+  }]
+}
+
+Important: modelPolicy belongs at the ROOT, never inside a lane. Prefer <=2 coherent surfaces and <=1 migration per lane; split independent chunks.`,
+  "follow-up": `Usage: fleet follow-up --stdin --json | --contract <file> --json
+
+JSON:
+{"schemaVersion":1,"workspacePath":"/absolute/worktree","laneId":"lane-a","message":"Continue the bounded task."}
+
+Follow-up preserves the owned Codex thread and existing authority.`,
+  cancel: `Usage:
+  fleet cancel <laneId> --workspace <worktree> [--json]          # preview
+  fleet cancel <laneId> --workspace <worktree> --confirm        # one-command confirmed shortcut
+  fleet cancel --stdin --json                                   # compatibility contract preview
+  fleet cancel --stdin --json --confirm                         # exact token/turn compatibility flow
+
+The shortcut still performs an identity-bound server preview before cancellation. Success is reported only after accepted:true. Touched files are returned so cancellation never implies a clean worktree.`,
+  status: `Usage: fleet status [--workspace <worktree>] [--summary] [--all] [--archived] [--json]
+
+Without --workspace, Fleet resolves cwd to its Git worktree root. Archived lanes are hidden unless --archived is supplied. An empty ledger warns when sibling Git worktrees contain Fleet lanes; Fleet does not silently merge their authority.`,
+  result: `Usage: fleet result --lane <id> [--workspace <worktree>] [--summary|--pretty|--full] [--wait] [--timeout-ms <ms>] [--json]
+
+--wait defaults to 600000 ms and blocks on the supervisor's event signal rather than 250 ms shell/status polling. Timeout is returned as a truthful still-running/queued result, including queue blocker data. --full prints the full retained decoded result.`,
+  watch: `Usage: fleet watch [--workspace <worktree>] [--timeout-ms <ms>] [--stall-ms <ms>] [--json]
+
+Waits on ONE existing supervisor for lane-terminal, controller-attention, intervention, queue-stalled, or continuation-unknown. It never creates a supervisor and never calls a model. Default timeout: 4h. Default queued-stall threshold: 20m.`,
+  models: `Usage: fleet models [--workspace <worktree>] [--refresh] [--json]
+
+Returns exact connected-runtime model IDs, discovery timestamp and age. --refresh restarts only an IDLE Fleet-owned Codex app-server; it refuses while lanes/reservations are active. If ~/.codex/config.toml names a model missing from the catalog, Fleet reports that mismatch and a refresh/restart hint instead of inventing an alias.`,
+  reconcile: `Usage:
+  fleet reconcile --lane <id> --workspace <worktree> [--json]
+  fleet reconcile --lane <id> --workspace <worktree> --assume-not-started --evidence-ref <ref> --confirm
+
+First form performs authoritative Codex-history probing only. Manual release of an ambiguous writer reservation requires BOTH explicit evidence and --confirm.`,
+  resolve: `Usage: fleet resolve --lane <id> --workspace <worktree> --evidence-ref <ref> --outcome complete|failed|cancelled --confirm [--json]
+
+Only outcome_unknown/interrupted lanes can be resolved. Evidence is required; this command never fabricates a successful result.`,
+  archive: `Usage: fleet archive --lane <id> --workspace <worktree> [--json]
+
+Archives a terminal lane. Default status hides archived lanes; status --archived includes them. Archive does not delete evidence or Codex history.`,
+  init: `Usage: fleet init --list --json
+   or: fleet init --template research|implementation|verification|image-generation --workspace <path> --objective <text> [--confirmation-ref <ref>] --json
+
+Templates separate start/completion/controller verification gates and include environment-safe verification posture.`,
+  doctor: `Usage: fleet doctor [--workspace <worktree>] [--json]
+
+Read/probe local capabilities. It never widens lane authority.`,
+  projects: `Usage: fleet projects [--json]
+
+Lists registered Fleet workspace ledgers without exposing canonical private paths.`,
+  register: `Usage: fleet register --workspace <worktree> [--name <label>] [--json]`,
+  inventory: `Usage: fleet inventory [--workspace <path>] [--native] [--archived] [--query <literal>] [--limit 1..500] [--cursor <cursor>] [--json]`,
+  inbox: `Usage: fleet inbox [--workspace <worktree>] [--request <id>] [--json]`,
+  "inbox-wait": `Usage: fleet inbox-wait [--workspace <worktree>] [--timeout-ms 1..90000] [--after <cursor>] [--json]`,
+  "inbox-propose": `Usage: fleet inbox-propose --stdin --json | --contract <file> --json`,
+  "inbox-answer": `Usage: fleet inbox-answer --stdin --json | --contract <file> --json`,
+  export: `Usage: fleet export --workspace <worktree> --output <file> [--confirm-token <preview-token>] [--json]`,
+  setup: `Usage: fleet setup [--confirm-token <preview-token>] [--json]`,
+  uninstall: `Usage: fleet uninstall [--confirm-token <preview-token>] [--json]`
+});
+
+export function renderCliHelp(command = null) {
+  if (!command) return ROOT;
+  return HELP[command] ?? `${ROOT}\n\nNo command-specific help is registered for ${String(command)}.`;
+}
