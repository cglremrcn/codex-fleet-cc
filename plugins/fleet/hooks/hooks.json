{
  "description": "Read existing Fleet state at session start without launching work.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/fleet-session-hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
